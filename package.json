{
  "name": "cce",
  "displayName": "CCE - Code Chat Extension",
  "description": "AI-powered chatbot for code assistance with multi-model support",
  "version": "0.0.23",
  "publisher": "5im-on",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/5im-0n/cce"
  },
  "keywords": ["chat", "ai", "llm", "coding-assistant"],
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Chat",
    "AI",
    "Other"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cce",
          "title": "CCE Chat",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "cce": [
        {
          "type": "webview",
          "id": "cce.chatView",
          "name": "Chat",
          "icon": "resources/icon.svg",
          "contextValue": "cce.chatView"
        }
      ]
    },
    "commands": [
      {
        "command": "cce.openChat",
        "title": "CCE: Open Chat",
        "icon": "$(comment-discussion)"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "eslint": "^8.50.0"
  },
  "dependencies": {
    "marked": "^18.0.7"
  }
}
